{
  "version": 1,
  "device": "MI 9",
  "web": {
    "enabled": true,
    "port": 8080,
    "user": "admin",
    "pass": "首次启动随机生成",
    "token": "首次启动随机生成"
  },
  "sms": {
    "enabled": true,
    "dedupWindowSec": 90,
    "defaultSubId": -1
  },
  "sims": {
    "slot1": "",
    "slot2": "",
    "autoSimLine": true
  },
  "rulesDefault": "all",
  "channels": [
    {
      "name": "webhook",
      "type": "webhook",
      "url": "https://example.com/sms",
      "token": "可选 X-Token",
      "template": "{peer}\n{body}\n设备：{device}\n接收号码：{sim}",
      "tag": "",
      "maxTries": 10,
      "enabled": false
    },
    {
      "name": "dingtalk",
      "type": "dingtalk",
      "url": "https://oapi.dingtalk.com/robot/send?access_token=xxx",
      "secret": "SECxxx",
      "format": "text",
      "title": "",
      "template": "{peer}\n{body}\n设备：{device}\n接收号码：{sim}",
      "maxTries": 10,
      "enabled": false
    },
    {
      "name": "telegram",
      "type": "telegram",
      "token": "123456:ABC-DEF",
      "chatId": "123456789",
      "template": "{peer}\n{body}\n设备：{device}\n接收号码：{sim}",
      "maxTries": 10,
      "enabled": false
    }
  ],
  "rules": [
    {
      "name": "验证码优先",
      "enabled": true,
      "peer": ["^106"],
      "body": ["验证码|动态码"],
      "channels": ["dingtalk"],
      "priority": 10,
      "stop": false
    },
    {
      "name": "退订丢弃",
      "enabled": true,
      "body": ["退订|TD$"],
      "action": "drop"
    }
  ],
  "ddns": {
    "enabled": false,
    "provider": "cloudflare",
    "token": "在面板填写，建议只给 Zone:DNS:Edit",
    "zone": "example.com",
    "intervalMin": 10,
    "family": "v6",
    "records": [
      {"name": "home.example.com", "ttl": 120, "proxied": false}
    ]
  },
  "monitor": {
    "enabled": true
  },
  "alerts": {
    "enabled": true,
    "notify": true,
    "intervalMin": 5,
    "cooldownMin": 30,
    "channels": [],
    "thresholds": {
      "lowPct": 20,
      "highPct": 80,
      "tempC": 42,
      "pending": 20,
      "heartbeatSec": 180,
      "failStreak": 3,
      "highSustainMin": 30,
      "netSustainMin": 5
    }
  },
  "retention": {
    "days": 30
  },
  "transfer": {
    "enabled": true,
    "allowInstall": true,
    "maxFileBytes": 31457280,
    "maxTotalBytes": 104857600,
    "keepDays": 30
  },
  "notes": {
    "maxItems": 100,
    "pollSec": 5
  },
  "log": {
    "level": "info",
    "maxLines": 500
  }
}
